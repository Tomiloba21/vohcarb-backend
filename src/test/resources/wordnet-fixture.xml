    <Synset id="oewn-001-n" members="oewn-dog-n oewn-domestic_dog-n oewn-Canis-n" partOfSpeech="n" lexfile="noun.animal">
      <Definition>a member of the genus Canis that has been domesticated by man since prehistoric times</Definition>
      <SynsetRelation relType="hypernym" target="oewn-008-n"/>
    </Synset>
    <Synset id="oewn-002-n" members="oewn-dog-n" partOfSpeech="n" lexfile="noun.person">
      <Definition>informal term for a man</Definition>
      <Example>you lucky dog</Example>
    </Synset>
    <Synset id="oewn-003-v" members="oewn-dog-v" partOfSpeech="v" lexfile="verb.motion">

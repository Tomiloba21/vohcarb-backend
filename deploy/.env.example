# Copy to .env (never commit .env) and fill in. Generate secrets with: openssl rand -base64 48

# Your API's domain, pointed at the server with a DNS A record. Use :80 until you have one.
DOMAIN=api.example.com

DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Signs everyone's login tokens. At least 32 characters. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Path inside the container to the Firebase service-account key (put the file in deploy/secrets/).
# Leave empty until you have a Firebase project: notifications are then only logged.
FCM_CREDENTIALS_FILE=
